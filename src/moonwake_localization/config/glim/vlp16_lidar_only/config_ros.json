{
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 0.0,
    "imu_frame_id": "velodyne",
    "lidar_frame_id": "velodyne",
    "base_frame_id": "velodyne",
    "odom_frame_id": "odom",
    "map_frame_id": "map",
    "publish_imu2lidar": false,
    "tf_time_offset": 1e-6,
    "extension_modules": [
      "libstandard_viewer.so",
      "librviz_viewer.so"
    ],
    "imu_topic": "/moonwake_unused_imu",
    "points_topic": "/velodyne_points",
    "image_topic": "/moonwake_unused_image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data",
      "depth": 10,
      "reliability": "reliable",
      "durability": "volatile",
      "history": "keep_last"
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
